# ============================================
# InstaPay Detector Gateway — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.

# --- Database ---
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"
# Production (Render PostgreSQL):
# DATABASE_URL="postgres://user:pass@host:port/dbname"

# --- Security ---
# Shared secret between the Android app and the webhook.
# Generate a strong random string: openssl rand -hex 32
DETECT_TOKEN="instapay-sandbox-detector-token-2026"

# --- Merchant config ---
MERCHANT_HANDLE="mohammedshabana77@instapay"
MERCHANT_NAME="Mohammed Shabana"

# Pending checkout lifetime in minutes (default: 10)
CHECKOUT_TTL_MIN=10

# --- Production only (leave unset for local dev) ---
# The notifier service URL. On Render: https://your-notifier-service.onrender.com
# NOTIFIER_URL=

# Same as NOTIFIER_URL but exposed to the browser (NEXT_PUBLIC_ prefix).
# NEXT_PUBLIC_NOTIFIER_URL=

# Restricts which origins can connect to the notifier's socket.io.
# On Render: https://your-gateway-service.onrender.com
# CORS_ORIGIN=
