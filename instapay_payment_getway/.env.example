# ============================================
# InstaPay Gateway — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the real .env file to git.

# --- Database ---
# Local dev (SQLite):
DATABASE_URL="file:./db/custom.db"
# Production (PostgreSQL):
# DATABASE_URL="postgres://user:pass@host:port/dbname"

# --- Core secrets ---
# Signs merchant sessions and authorizes platform-owner API access.
# Generate: openssl rand -hex 32
OWNER_SECRET=

# Pepper used when hashing API keys and detector tokens.
# Generate: openssl rand -hex 32
TOKEN_PEPPER=

# --- Admin portal credentials ---
# Required for admin sign-in. Do not hardcode these in source.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Base32 TOTP secret for admin 2FA (32 chars).
ADMIN_TOTP_SECRET=
# Optional obscured admin portal path segment.
# NEXT_PUBLIC_ADMIN_PORTAL_PATH=

# --- Platform subscription billing ---
# The account that receives merchant subscription payments.
PLATFORM_INSTAPAY_HANDLE=
# Static InstaPay payment URL for the platform account, copied from the InstaPay app.
PLATFORM_INSTAPAY_PAYMENT_URL=

# --- Checkout behaviour ---
# Pending checkout lifetime in minutes (default: 10)
CHECKOUT_TTL_MIN=10
# Fallback token used to derive payment URLs when a merchant has no static URL set.
# DEFAULT_INSTAPAY_PAYMENT_TOKEN=

# --- Realtime notifier (optional) ---
# NOTIFIER_URL=
# NEXT_PUBLIC_NOTIFIER_URL=
# CORS_ORIGIN=

# --- Development-only relaxations. Never enable in production. ---
# ALLOW_HTTP_WEBHOOKS=1
# ALLOW_PRIVATE_WEBHOOKS=1
# SEED_PLANS_ON_STARTUP=1
