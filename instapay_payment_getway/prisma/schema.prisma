// Multi-tenant InstaPay Payment Gateway — Prisma Schema (SQLite for local dev)
//
// Roles:
//   Owner  = platform admin (you). Creates & manages clients.
//   Client = a business/individual who integrates the gateway.
//            Each client has their own InstaPay handle, API key,
//            detect token, and an Android APK on their phone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Platform owner (admin) ────────────────────────────────────────
model Owner {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

// ─── Client (business / individual using the gateway) ──────────────
model Client {
  id             String   @id @default(cuid())
  slug           String   @unique  // URL-safe identifier, e.g. "ahmed-electronics"
  businessName   String
  instapayHandle String             // their InstaPay handle, e.g. "ahmed_shop@instapay"

  // Authentication
  apiKey      String @unique        // for API calls (checkout create, status)
  detectToken String @unique        // for the Android APK webhook auth

  // Optional callback — gateway POSTs confirmed events here
  webhookUrl    String?
  webhookSecret String?             // HMAC-SHA256 secret for signing payloads

  // Status
  isActive Boolean @default(true)

  // Settings
  checkoutTtlMin Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  @@index([instapayHandle])
  @@index([apiKey])
  @@index([detectToken])
}

// ─── Checkout / payment transaction ────────────────────────────────
model Transaction {
  id        String @id @default(cuid())
  sessionId String @unique @default(cuid())

  // Multi-tenant: every transaction belongs to a client
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  senderHandle    String
  recipientHandle String

  amountEgp Float
  currency  String   @default("EGP")

  // PENDING → CONFIRMED | EXPIRED
  status String @default("PENDING")
  note   String?

  // InstaPay deep link for this checkout
  deepLinkUrl   String
  deepLinkToken String

  // Populated when the Android detector confirms the payment
  detectedRef String?
  detectedAt  DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([clientId, status, createdAt])
  @@index([clientId, senderHandle, amountEgp, status])
  @@index([status, expiresAt])
  @@index([deepLinkToken])
  @@index([createdAt])
}
