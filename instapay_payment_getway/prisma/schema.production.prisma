// Multi-tenant Paymob-Style Payment Gateway — Prisma Schema (PostgreSQL for production)
//
// The Render build command copies this over schema.prisma before building:
//   cp prisma/schema.production.prisma prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform owner (admin) ────────────────────────────────────────
model Owner {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  dstMode      String   @default("AUTO")
  createdAt    DateTime @default(now())
}

// ─── Client / Merchant Account (Self-Service) ──────────────────────
model Client {
  id             String   @id @default(cuid())
  slug           String   @unique
  businessName   String
  instapayHandle String

  // Self-registration fields
  email          String   @unique
  passwordHash   String

  // Authentication keys (Generated ONLY after Admin Approval)
  apiKey      String? @unique
  detectToken String? @unique

  // Status: PENDING | APPROVED | REJECTED
  approvalStatus String  @default("PENDING")
  isActive       Boolean @default(false)

  // Webhook integration
  webhookUrl    String?
  webhookSecret String?

  // Settings
  checkoutTtlMin Int @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  webhookLogs  WebhookLog[]

  @@index([instapayHandle])
  @@index([apiKey])
  @@index([detectToken])
}

// ─── Checkout / payment transaction ────────────────────────────────
model Transaction {
  id        String @id @default(cuid())
  sessionId String @unique @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  senderHandle    String
  recipientHandle String

  amountEgp Float
  currency  String   @default("EGP")

  status String @default("PENDING")
  note   String?

  deepLinkUrl   String
  deepLinkToken String

  detectedRef String?
  detectedAt  DateTime?

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([clientId, status, createdAt])
  @@index([clientId, senderHandle, amountEgp, status])
  @@index([status, expiresAt])
  @@index([deepLinkToken])
  @@index([createdAt])
}

// ─── Webhook Delivery Log ──────────────────────────────────────────
model WebhookLog {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  url        String
  event      String
  payload    String   // Stringified JSON payload
  statusCode Int?     // HTTP status code returned
  response   String?  // Response body from merchant server
  isSuccess  Boolean
  createdAt  DateTime @default(now())

  @@index([clientId, createdAt])
}

// ─── Administrative Audit Log ──────────────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // e.g. "APPROVE_MERCHANT", "DISABLE_MERCHANT", "UPDATE_TZ", "FORCE_CONFIRM"
  details   String   // Text description
  createdAt DateTime @default(now())

  @@index([createdAt])
}
