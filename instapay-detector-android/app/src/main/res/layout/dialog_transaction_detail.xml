<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_card">

    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        tools:ignore="HardcodedText"
        android:text="Payment details" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="@color/border_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_from"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailFrom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_to"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailTo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_amount"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailAmount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/status_confirmed"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_status"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_reference"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailReference"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_date"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_note"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tx_detail_session"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/detailSession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/statusActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmTx"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/tx_action_confirm"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/status_confirmed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExpireTx"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/tx_action_expire"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/border_medium" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tx_detail_close"
        app:backgroundTint="@color/brand_primary" />

</LinearLayout>
