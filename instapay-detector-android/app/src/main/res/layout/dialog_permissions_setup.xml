<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/bg_card">

    <!-- Header with Icon & Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_brand_logo"
            android:layout_marginBottom="10dp"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/permDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_dialog_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permDialogSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/perm_dialog_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle"
        android:layout_marginBottom="16dp" />

    <!-- Permission 1: Notification Listener Access (Key) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/brand_primary"
            android:layout_marginEnd="12dp"
            android:contentDescription="Notification Listener" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_notification_listener_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_notification_listener_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantListener"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/perm_grant_btn"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/brand_primary" />

        <TextView
            android:id="@+id/txtListenerGranted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_granted"
            android:textColor="@color/status_confirmed"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Permission 2: Post Notifications (Alerts) -->
    <LinearLayout
        android:id="@+id/layoutPostNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge"
        android:padding="12dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_bell"
            app:tint="@color/brand_accent"
            android:layout_marginEnd="12dp"
            android:contentDescription="Post Notifications" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_post_notifications_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_post_notifications_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantPostNotifications"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/perm_grant_btn"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/brand_primary" />

        <TextView
            android:id="@+id/txtPostNotificationsGranted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_granted"
            android:textColor="@color/status_confirmed"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Permission 3: Battery Optimization Exemption -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_badge"
        android:padding="12dp"
        android:layout_marginBottom="18dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/bg_live_dot"
            app:tint="@color/status_pending"
            android:layout_marginEnd="12dp"
            android:contentDescription="Battery Optimization" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_battery_optimization_title"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/perm_battery_optimization_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGrantBattery"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/perm_grant_btn"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/brand_primary" />

        <TextView
            android:id="@+id/txtBatteryGranted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/perm_granted"
            android:textColor="@color/status_confirmed"
            android:textStyle="bold"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Done / Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/perm_done_btn"
        android:textSize="13sp"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/status_confirmed" />

</LinearLayout>
